# Environment Variables - Development

# Node Environment
NODE_ENV=development
PORT=3001
API_BASE_URL=http://localhost:3001

# Database (PostgreSQL)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/hospital_ai_os

# Redis
REDIS_URL=redis://localhost:6379

# Secrets (Change these in local .env, NEVER commit actual secrets)
JWT_PRIVATE_KEY_PATH=./keys/private.pem
JWT_PUBLIC_KEY_PATH=./keys/public.pem
ENCRYPTION_KEY=CHANGE_ME

# AI subsystem (ADR-017/020 ratified defaults — all optional; app boots with AI disabled)
# Production REQUIRES ENCRYPTION_KEY >= 32 chars or the AI subsystem stays disabled.
AI_ENABLED=true
AI_PROVIDER=google-gemini
AI_API_KEY=your-gemini-api-key-here
AI_MODEL=gemini-2.5-flash
AI_TIMEOUT_MS=30000
AI_MAX_TOKENS=4096
AI_DAILY_TOKEN_BUDGET=200000
AI_PER_USER_RATE_LIMIT=6
AI_SEMAPHORE_SIZE=4
AI_DRAFT_TTL_HOURS=24

# Operational Risk & Pattern Analytics Sidecar (Python FastAPI plugin)
HOSPITAL_ANALYTICS_URL=http://localhost:8001
