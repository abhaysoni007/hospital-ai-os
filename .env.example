# Environment Variables - Development

# Node Environment
NODE_ENV=development
PORT=3001
API_BASE_URL=http://localhost:3001

# Database (PostgreSQL)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/hospital_ai_os

# Redis
REDIS_URL=redis://localhost:6379

# Secrets (Change these in local .env, NEVER commit actual secrets)
JWT_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nCHANGE_ME\n-----END RSA PRIVATE KEY-----"
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\nCHANGE_ME\n-----END PUBLIC KEY-----"
ENCRYPTION_KEY=CHANGE_ME
AI_API_KEY=CHANGE_ME
